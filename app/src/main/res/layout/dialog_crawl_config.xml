<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Crawl &amp; Engine Configuration"
        android:textColor="@color/text_primary"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Tune crawling depth, viewports, and resource capture options."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Crawl Scope & Depth -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Crawl Scope &amp; Depth"
        android:textColor="@color/secondary_teal"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_scope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_scope_single"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Single Page Only" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_scope_site"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Full Site (Multi-Page)" />
    </com.google.android.material.chip.ChipGroup>

    <LinearLayout
        android:id="@+id/layout_depth_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_depth_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Max Crawl Depth: 2 levels"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_max_pages_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Max Pages: 10"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_depth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1.0"
            android:value="2.0"
            android:valueFrom="1.0"
            android:valueTo="5.0"
            app:thumbColor="@color/primary_neon"
            app:trackColorActive="@color/primary_neon" />
    </LinearLayout>

    <!-- Viewport Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Rendering Viewport"
        android:textColor="@color/secondary_teal"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_viewport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_vp_desktop"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Desktop (1920×1080)" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_vp_tablet"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tablet (768×1024)" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_vp_mobile"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mobile (375×812)" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Asset Options & QA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="High-Fidelity Pipeline Options"
        android:textColor="@color/secondary_teal"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_visual_diff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Automated Screenshot &amp; Pixel Diff Validation"
        android:textColor="@color/text_primary" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cb_lazy_scroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Simulate Controlled Scrolling (Trigger Lazy Loading)"
        android:textColor="@color/text_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_apply_config"
        style="@style/WebMirrorButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Apply Configuration" />
</LinearLayout>
