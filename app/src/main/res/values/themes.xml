<resources>
    <!-- WebMirror Modern Cyber Dark Theme -->
    <style name="Theme.WebMirror" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary_neon</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/secondary_teal</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorSurfaceVariant">@color/bg_surface_elevated</item>
        <item name="colorError">@color/status_error</item>

        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="cardViewStyle">@style/WebMirrorCard</item>
        <item name="bottomNavigationStyle">@style/WebMirrorBottomNav</item>
    </style>

    <style name="WebMirrorCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="WebMirrorBottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/bg_surface</item>
        <item name="itemIconTint">@color/primary_neon</item>
        <item name="itemTextColor">@color/text_primary</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="WebMirrorButtonPrimary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_neon</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WebMirrorButtonSecondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="WebMirrorChip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/bg_surface_elevated</item>
        <item name="chipStrokeColor">@color/border_subtle</item>
        <item name="chipCornerRadius">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
